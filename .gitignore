# ── R ──
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/python/

# ── Python / uv ──
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# ── Quarto ──
.quarto/
manuscript/.quarto/
manuscript/_book/
manuscript/_freeze/
manuscript/_objects/
manuscript/_table_images/
manuscript/.gitignore
manuscript/*.html
# House Quarto extensions are installed via `make setup` (not vendored) — see M3.
manuscript/_extensions/

# ── Pipeline run state, logs, archived runs ──
run_state/
logs/
runs/
.step11_reopen_to_step10

# ── Data (never commit raw or large data) ──
data/bronze/**
!data/bronze/.gitkeep
data/silver/*.parquet
data/silver/*.rds
data/gold/**
!data/gold/.gitkeep

# ── Secrets / local / OS ──
.env
.env.*
.claude/settings.local.json
.DS_Store
.idea/
.vscode/
*.swp
.web-search-hook.log
